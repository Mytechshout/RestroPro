APP_NAME="OneOs Pos"
DATABASE_URL="mysql://test_user:test_pass@hostname_here/my_db_name"
# Set to true only when the database server requires TLS.
DATABASE_SSL=false
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRY=15m
JWT_EXPIRY_REFRESH=30d

# provide in ms - milliseconds => 15 minute, 30days | match the value to JWT expiry
COOKIE_EXPIRY=300000
COOKIE_EXPIRY_REFRESH=2592000000

PASSWORD_SALT=10
FRONTEND_DOMAIN="https://pos.oneos.in" # For Development: http://localhost:5173
FRONTEND_DOMAIN_COOKIE="pos.oneos.in" # For Development: localhost

STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

SMTP_HOST=
SMTP_PORT=
SMTP_EMAIL=
SMTP_PASSWORD=

ENCRYPTION_KEY=replace_with_a_separate_long_random_secret

# Used only by: npm run create-superadmin
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
SUPERADMIN_NAME="Super Admin"
